{
    "configurations": [
        {
            "name": "Win64-Cross",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/x86_64-w64-mingw32/include"
            ],
            "defines": [
                "_WIN64",
                "WIN32_LEAN_AND_MEAN"
            ],
            "compilerPath": "/usr/bin/x86_64-w64-mingw32-gcc",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}
